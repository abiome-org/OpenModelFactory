{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-omf-kind": "Knowledge",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "omf.dev/v1alpha1"},
    "kind": {"const": "Knowledge"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {
      "type": "object",
      "required": ["category", "claim", "confidence", "evidence"],
      "properties": {
        "category": {
          "enum": ["observation", "hypothesis", "decision", "constraint", "lesson", "retraction"]
        },
        "claim": {"type": "string", "minLength": 1, "maxLength": 8192},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref"],
            "properties": {
              "ref": {"type": "string", "minLength": 1, "maxLength": 4096},
              "digest": {"type": "string", "pattern": "^[a-z][a-z0-9+._-]*:[0-9a-f]+$"}
            },
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 64
        },
        "scope": {
          "type": "object",
          "properties": {
            "goalRefs": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "resourceRefs": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "runIds": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "tags": {
              "type": "array",
              "items": {"type": "string", "minLength": 1, "maxLength": 128},
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "supersedes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "maxItems": 64
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "extensions": {"$ref": "#/$defs/extension"}
      },
      "additionalProperties": false
    },
    "status": {"type": "object"}
  },
  "additionalProperties": false
}
