{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-omf-kind": "Checkpoint",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "omf.dev/v1alpha1"},
    "kind": {"const": "Checkpoint"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {
      "type": "object",
      "required": ["runRef", "artifactRef", "components", "replay"],
      "properties": {
        "runRef": {"type": "string", "minLength": 1},
        "artifactRef": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "components": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "replay": {
          "oneOf": [
            {
              "type": "object",
              "required": ["status", "reason"],
              "properties": {
                "status": {"const": "not-claimed"},
                "reason": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["status", "samplerStateRef", "mixRef"],
              "properties": {
                "status": {"const": "bound"},
                "samplerStateRef": {"type": "string", "minLength": 1},
                "mixRef": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          ]
        },
        "extensions": {"$ref": "#/$defs/extension"}
      },
      "additionalProperties": false
    },
    "status": {"type": "object"}
  },
  "additionalProperties": false
}
