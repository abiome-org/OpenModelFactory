{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-omf-kind": "Module",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "omf.dev/v1alpha1"},
    "kind": {"const": "Module"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {
      "type": "object",
      "required": ["contractVersion", "moduleKind", "entryPoint", "contracts", "environment", "lifecycle", "access", "provenance", "fixtures"],
      "properties": {
        "contractVersion": {"const": "omf.module/v1"},
        "moduleKind": {"type": "string", "minLength": 1},
        "entryPoint": {
          "type": "object",
          "required": ["command"],
          "properties": {
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "codeRoot": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            }
          },
          "additionalProperties": false
        },
        "contracts": {
          "type": "object",
          "required": ["input", "output", "config", "state"],
          "properties": {
            "input": {"type": "object", "minProperties": 1},
            "output": {"type": "object", "minProperties": 1},
            "config": {"type": "object", "minProperties": 1},
            "state": {"type": "object", "minProperties": 1}
          },
          "additionalProperties": false
        },
        "environment": {
          "type": "object",
          "required": ["dependencyLock", "dependencyDigest"],
          "properties": {
            "dependencyLock": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "dependencyDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "platforms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "resources": {
          "type": "object",
          "properties": {
            "minimumCpu": {"type": "number", "exclusiveMinimum": 0},
            "minimumMemoryBytes": {"type": "integer", "minimum": 1},
            "acceleratorCapabilities": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            },
            "minimumStorageBytes": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "determinism": {"type": "string"},
        "lifecycle": {
          "type": "object",
          "required": ["checkpoint", "sideEffects", "concurrency"],
          "properties": {
            "checkpoint": {"type": "boolean"},
            "sideEffects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "concurrency": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "access": {
          "type": "object",
          "required": ["secrets", "network"],
          "properties": {
            "secrets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "network": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "required": ["license"],
          "properties": {
            "license": {"type": "string", "minLength": 1},
            "sourceRef": {"type": "string", "minLength": 1},
            "buildRef": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["request", "result"],
            "properties": {
              "request": {"type": "object"},
              "result": {"type": "object"}
            },
            "additionalProperties": false
          }
        },
        "extensions": {"$ref": "#/$defs/extension"}
      },
      "additionalProperties": false
    },
    "status": {"type": "object"}
  },
  "additionalProperties": false
}
